# Resend — server-side only, never exposed to the client.
RESEND_API_KEY=

# Where enquiry emails are delivered. Confirmed 2026-08-23.
# Optional: the code already falls back to info@tourglobe.in. Set this only
# to send enquiries somewhere else.
ENQUIRY_TO_EMAIL=info@tourglobe.in

# REQUIRED. The address Resend sends *as*. This is NOT the inbox above — it
# must sit on a domain verified in Resend (add its DNS records first), and it
# should differ from ENQUIRY_TO_EMAIL, since mail from and to the same
# address is more likely to be filtered as spam. It does not need to be a
# real mailbox; replies go to the visitor via the Reply-To header.
ENQUIRY_FROM_EMAIL=enquiry@tourglobe.in

# Canonical origin used for metadata, sitemap and JSON-LD.
# Must match the live domain exactly. A blank value falls back to the default.
NEXT_PUBLIC_SITE_URL=https://www.tourglobe.in
